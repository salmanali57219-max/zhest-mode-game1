<!DOCTYPE html>

<html lang="fa" dir="rtl">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, viewport-fit=cover">
<meta name="theme-color" content="#0b0b0b">
<title>ژست مد | بازی کن، امتیاز بگیر</title>

<style>
@import url('https://fonts.googleapis.com/css2?family=Vazirmatn:wght@400;500;600;700;800&display=swap');

:root{
    --bg:#080808;
    --bg-soft:#111111;
    --card:#151515;
    --card-2:#1b1b1b;
    --white:#f7f5f0;
    --muted:#9d9b96;
    --gold:#d8b875;
    --gold-soft:#f0d9a1;
    --line:rgba(255,255,255,.09);
    --danger:#ff5b5b;
    --success:#73d69a;
}

*{
    box-sizing:border-box;
    margin:0;
    padding:0;
}

html{
    scroll-behavior:smooth;
}

body{
    background:var(--bg);
    color:var(--white);
    font-family:'Vazirmatn',sans-serif;
    overflow-x:hidden;
}

button,
input{
    font-family:inherit;
}

button{
    cursor:pointer;
}

.page{
    min-height:100svh;
    position:relative;
    overflow:hidden;
}

/* =========================
   BACKGROUND
========================= */

.ambient{
    position:absolute;
    inset:0;
    pointer-events:none;
    overflow:hidden;
}

.ambient::before{
    content:"";
    position:absolute;
    width:420px;
    height:420px;
    border-radius:50%;
    background:rgba(216,184,117,.08);
    filter:blur(90px);
    top:-180px;
    right:-150px;
}

.ambient::after{
    content:"";
    position:absolute;
    width:300px;
    height:300px;
    border-radius:50%;
    background:rgba(255,255,255,.035);
    filter:blur(100px);
    bottom:-120px;
    left:-120px;
}

/* =========================
   HEADER
========================= */

.topbar{
    position:relative;
    z-index:5;
    height:74px;
    display:flex;
    align-items:center;
    justify-content:space-between;
    padding:0 22px;
    border-bottom:1px solid var(--line);
}

.brand{
    display:flex;
    align-items:center;
    gap:10px;
}

.brand-mark{
    width:35px;
    height:35px;
    border:1px solid rgba(216,184,117,.7);
    display:grid;
    place-items:center;
    transform:rotate(45deg);
}

.brand-mark span{
    transform:rotate(-45deg);
    font-size:13px;
    color:var(--gold-soft);
    font-weight:800;
}

.brand-name{
    display:flex;
    flex-direction:column;
    line-height:1.1;
}

.brand-name strong{
    font-size:15px;
    letter-spacing:2px;
}

.brand-name small{
    color:var(--muted);
    font-size:9px;
    letter-spacing:1.5px;
    margin-top:4px;
}

.status{
    display:flex;
    align-items:center;
    gap:7px;
    font-size:10px;
    color:var(--muted);
}

.status-dot{
    width:7px;
    height:7px;
    border-radius:50%;
    background:var(--success);
    box-shadow:0 0 12px rgba(115,214,154,.7);
}

/* =========================
   HERO
========================= */

.hero{
    position:relative;
    z-index:2;
    min-height:calc(100svh - 74px);
    display:flex;
    flex-direction:column;
    justify-content:center;
    padding:48px 22px 38px;
}

.eyebrow{
    display:inline-flex;
    align-items:center;
    gap:8px;
    width:max-content;
    border:1px solid rgba(216,184,117,.22);
    background:rgba(216,184,117,.05);
    border-radius:100px;
    padding:7px 12px;
    color:var(--gold-soft);
    font-size:10px;
    margin-bottom:22px;
}

.eyebrow i{
    width:5px;
    height:5px;
    border-radius:50%;
    background:var(--gold);
}

.hero h1{
    font-size:clamp(42px,13vw,72px);
    line-height:1.05;
    font-weight:800;
    letter-spacing:-2px;
    max-width:560px;
}

.hero h1 span{
    color:var(--gold-soft);
}

.hero-description{
    color:var(--muted);
    font-size:14px;
    line-height:2;
    margin-top:22px;
    max-width:500px;
}

.hero-actions{
    display:flex;
    flex-direction:column;
    gap:11px;
    margin-top:32px;
    max-width:500px;
}

.primary-btn{
    width:100%;
    min-height:56px;
    border:0;
    border-radius:14px;
    background:var(--white);
    color:#0a0a0a;
    font-weight:800;
    font-size:14px;
    transition:.25s ease;
}

.primary-btn:active{
    transform:scale(.98);
}

.secondary-btn{
    width:100%;
    min-height:52px;
    border:1px solid var(--line);
    border-radius:14px;
    background:rgba(255,255,255,.025);
    color:var(--white);
    font-size:13px;
}

/* =========================
   GAME PREVIEW
========================= */

.game-preview{
    position:relative;
    margin-top:48px;
    width:100%;
    height:190px;
    border:1px solid var(--line);
    border-radius:24px;
    background:
        linear-gradient(145deg,rgba(255,255,255,.045),rgba(255,255,255,.01));
    overflow:hidden;
}

.preview-label{
    position:absolute;
    top:17px;
    right:18px;
    font-size:9px;
    letter-spacing:2px;
    color:var(--muted);
    direction:ltr;
}

.preview-score{
    position:absolute;
    top:17px;
    left:18px;
    font-size:12px;
    color:var(--gold-soft);
    direction:ltr;
}

.rack{
    position:absolute;
    left:14%;
    right:14%;
    bottom:45px;
    height:3px;
    background:rgba(255,255,255,.35);
}

.rack::before,
.rack::after{
    content:"";
    position:absolute;
    width:3px;
    height:40px;
    background:rgba(255,255,255,.2);
    bottom:0;
}

.rack::before{
    right:0;
}

.rack::after{
    left:0;
}

.clothing{
    position:absolute;
    bottom:49px;
    width:37px;
    height:55px;
    border-radius:8px 8px 11px 11px;
    background:linear-gradient(145deg,#ece8df,#a9a59e);
    animation:float 3s ease-in-out infinite;
}

.clothing::before{
    content:"";
    position:absolute;
    top:-9px;
    left:8px;
    width:20px;
    height:18px;
    border-radius:50% 50% 4px 4px;
    background:inherit;
}

.clothing:nth-child(1){
    right:23%;
    animation-delay:.3s;
}

.clothing:nth-child(2){
    right:44%;
    height:62px;
    width:42px;
    background:linear-gradient(145deg,#d8b875,#806a3d);
    animation-delay:1s;
}

.clothing:nth-child(3){
    right:66%;
    animation-delay:1.7s;
}

@keyframes float{
    0%,100%{transform:translateY(0) rotate(-2deg)}
    50%{transform:translateY(-9px) rotate(2deg)}
}

.preview-bottom{
    position:absolute;
    bottom:14px;
    left:18px;
    right:18px;
    display:flex;
    justify-content:space-between;
    color:var(--muted);
    font-size:9px;
}

/* =========================
   RULES SCREEN
========================= */

.screen{
    display:none;
    position:fixed;
    inset:0;
    z-index:20;
    background:var(--bg);
    overflow-y:auto;
}

.screen.active{
    display:block;
    animation:screenIn .35s ease;
}

@keyframes screenIn{
    from{
        opacity:0;
        transform:translateY(15px);
    }
    to{
        opacity:1;
        transform:none;
    }
}

.screen-inner{
    min-height:100svh;
    max-width:620px;
    margin:auto;
    padding:24px 20px 40px;
}

.screen-header{
    display:flex;
    align-items:center;
    justify-content:space-between;
    margin-bottom:42px;
}

.back-btn{
    width:42px;
    height:42px;
    border-radius:50%;
    border:1px solid var(--line);
    background:transparent;
    color:var(--white);
    font-size:18px;
}

.step{
    color:var(--muted);
    font-size:10px;
    direction:ltr;
}

.screen-title{
    font-size:30px;
    font-weight:800;
    line-height:1.3;
}

.screen-subtitle{
    color:var(--muted);
    font-size:13px;
    line-height:2;
    margin-top:12px;
}

/* =========================
   RULE CARDS
========================= */

.rules{
    margin-top:30px;
    display:grid;
    gap:10px;
}

.rule{
    display:flex;
    align-items:flex-start;
    gap:13px;
    padding:16px;
    border:1px solid var(--line);
    border-radius:17px;
    background:rgba(255,255,255,.025);
}

.rule-number{
    flex:0 0 28px;
    width:28px;
    height:28px;
    border-radius:9px;
    display:grid;
    place-items:center;
    background:rgba(216,184,117,.09);
    color:var(--gold-soft);
    font-size:11px;
}

.rule strong{
    display:block;
    font-size:12px;
    margin-bottom:5px;
}

.rule p{
    color:var(--muted);
    font-size:11px;
    line-height:1.9;
}

/* =========================
   LAUNCHER NOTICE
========================= */

.launcher-notice{
    margin-top:24px;
    padding:19px;
    border:1px solid rgba(216,184,117,.28);
    border-radius:18px;
    background:linear-gradient(
        135deg,
        rgba(216,184,117,.09),
        rgba(255,255,255,.02)
    );
}

.launcher-top{
    display:flex;
    align-items:center;
    gap:10px;
}

.key-icon{
    width:34px;
    height:34px;
    border-radius:10px;
    background:rgba(216,184,117,.1);
    display:grid;
    place-items:center;
    color:var(--gold-soft);
}

.launcher-notice strong{
    font-size:13px;
}

.launcher-notice p{
    color:var(--muted);
    font-size:11px;
    line-height:1.9;
    margin-top:10px;
}

.support-number{
    direction:ltr;
    display:block;
    color:var(--gold-soft);
    font-size:15px;
    font-weight:700;
    margin-top:8px;
}

/* =========================
   FORM
========================= */

.form{
    margin-top:30px;
}

.field{
    margin-bottom:16px;
}

.field label{
    display:block;
    color:var(--muted);
    font-size:11px;
    margin-bottom:8px;
}

.field input{
    width:100%;
    height:54px;
    border:1px solid var(--line);
    border-radius:14px;
    background:#111;
    color:var(--white);
    outline:none;
    padding:0 15px;
    font-size:13px;
    transition:.2s;
}

.field input:focus{
    border-color:rgba(216,184,117,.6);
    box-shadow:0 0 0 3px rgba(216,184,117,.06);
}

.launcher-input{
    direction:ltr;
    text-align:left;
    letter-spacing:3px;
    font-weight:700;
}

.error{
    display:none;
    color:var(--danger);
    font-size:10px;
    margin-top:7px;
}

.error.show{
    display:block;
}

.form-submit{
    margin-top:12px;
}

/* =========================
   OTP
========================= */

.otp-boxes{
    display:flex;
    direction:ltr;
    gap:8px;
    justify-content:center;
    margin:30px 0;
}

.otp-boxes input{
    width:43px;
    height:53px;
    text-align:center;
    border:1px solid var(--line);
    background:#111;
    color:var(--white);
    border-radius:12px;
    font-size:19px;
    font-weight:700;
    outline:none;
}

.otp-boxes input:focus{
    border-color:var(--gold);
}

.otp-info{
    text-align:center;
    color:var(--muted);
    font-size:11px;
    line-height:2;
}

.resend{
    text-align:center;
    margin-top:17px;
    color:var(--gold-soft);
    font-size:11px;
}

/* =========================
   RESPONSIVE
========================= */

@media(min-width:700px){

    .topbar{
        padding:0 42px;
    }

    .hero{
        max-width:850px;
        margin:auto;
        padding-left:30px;
        padding-right:30px;
    }

    .hero-actions{
        flex-direction:row;
    }

    .primary-btn,
    .secondary-btn{
        width:auto;
        padding:0 28px;
    }

    .game-preview{
        height:230px;
    }
}
</style>

</head>

