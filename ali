<script>

/* =========================
   SCREEN CONTROL
========================= */

const screens = {
    rules: document.getElementById('rulesScreen'),
    login: document.getElementById('loginScreen'),
    otp: document.getElementById('otpScreen')
};

function openScreen(screen){
    Object.values(screens).forEach(item=>{
        item.classList.remove('active');
    });

    screen.classList.add('active');
    document.body.style.overflow = 'hidden';
    window.scrollTo(0,0);
}

function closeScreen(screen){
    screen.classList.remove('active');

    if(!document.querySelector('.screen.active')){
        document.body.style.overflow = '';
    }
}


/* =========================
   LANDING ACTIONS
========================= */

document.getElementById('rulesBtn').addEventListener('click',()=>{
    openScreen(screens.rules);
});

document.getElementById('startGameBtn').addEventListener('click',()=>{
    openScreen(screens.login);
});

document.getElementById('rulesContinueBtn').addEventListener('click',()=>{
    openScreen(screens.login);
});


document.querySelectorAll('[data-close]').forEach(btn=>{

    btn.addEventListener('click',()=>{

        const target =
            document.getElementById(
                btn.dataset.close
            );

        closeScreen(target);

    });

});


/* =========================
   LOGIN
========================= */

const loginForm =
    document.getElementById('loginForm');

loginForm.addEventListener('submit',(event)=>{

    event.preventDefault();

    const name =
        document.getElementById('fullName').value.trim();

    const mobile =
        document.getElementById('mobile').value.trim();

    const launcher =
        document.getElementById('launcherCode').value.trim();

    const launcherError =
        document.getElementById('launcherError');


    launcherError.classList.remove('show');


    if(!name){
        document.getElementById('fullName').focus();
        return;
    }


    if(!mobile || mobile.length < 10){
        document.getElementById('mobile').focus();
        return;
    }


    if(!launcher){

        launcherError.classList.add('show');
        document.getElementById('launcherCode').focus();
        return;

    }


    /*
      در نسخه واقعی اینجا درخواست API ارسال می‌شود:

      POST /api/auth/request-otp

      {
          name,
          mobile,
          launcher
      }

      سرور باید:
      1. اعتبار Launcher را بررسی کند.
      2. مالکیت Launcher را بررسی کند.
      3. یک‌بارمصرف بودن آن را بررسی کند.
      4. OTP ایجاد کند.
      5. SMS ارسال کند.
    */


    const masked =
        mobile.slice(0,3) +
        '*******' +
        mobile.slice(-2);

    document.getElementById('maskedMobile')
        .textContent = masked;

    openScreen(screens.otp);

    startTimer();

});


/* =========================
   OTP INPUT
========================= */

const otpInputs =
    document.querySelectorAll('.otp-boxes input');

otpInputs.forEach((input,index)=>{

    input.addEventListener('input',()=>{

        if(input.value && index < otpInputs.length-1){
            otpInputs[index+1].focus();
        }

    });

    input.addEventListener('keydown',(event)=>{

        if(
            event.key === 'Backspace' &&
            !input.value &&
            index > 0
        ){
            otpInputs[index-1].focus();
        }

    });

});


/* =========================
   OTP VERIFY
========================= */

document.getElementById('verifyBtn')
    .addEventListener('click',()=>{

        const code =
            [...otpInputs]
            .map(input=>input.value)
            .join('');

        if(code.length !== 6){
            otpInputs[0].focus();
            return;
        }


        /*
          نسخه واقعی:

          POST /api/auth/verify-otp

          {
              mobile,
              otp
          }

          در صورت موفقیت:
          session/token ایجاد می‌شود
          و کاربر به Game Hub منتقل می‌شود.
        */


        alert(
            'ورود موفق بود.\n\nدر مرحله بعد Game Hub ژست مد را می‌سازیم.'
        );

    });


/* =========================
   TIMER
========================= */

let timerInterval;

function startTimer(){

    clearInterval(timerInterval);

    let seconds = 59;

    const timer =
        document.getElementById('timer');

    timer.textContent = '00:59';

    timerInterval =
        setInterval(()=>{

            seconds--;

            timer.textContent =
                '00:' +
                String(seconds).padStart(2,'0');

            if(seconds <= 0){
                clearInterval(timerInterval);
                timer.textContent = 'ارسال مجدد';
            }

        },1000);
}

</script>

